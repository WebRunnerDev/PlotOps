VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Optional — local Docker stack (overrides .env). After `npm run db:start`:
# VITE_SUPABASE_URL=http://127.0.0.1:54321
# VITE_SUPABASE_PUBLISHABLE_KEY=<publishable key from npm run db:local-status>

# Optional — local GitHub OAuth (separate OAuth App; callback http://127.0.0.1:54321/auth/v1/callback)
# SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=

# Optional — local Google OAuth (separate OAuth App; callback http://127.0.0.1:54321/auth/v1/callback)
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Optional — for `supabase login` alternative / CI
# SUPABASE_ACCESS_TOKEN=your_personal_access_token
