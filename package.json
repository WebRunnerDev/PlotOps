{
    "name": "plotops",
    "private": true,
    "version": "0.0.0",
    "license": "MIT",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build && node scripts/prerender.mjs",
        "prerender": "node scripts/prerender.mjs",
        "typecheck": "tsc -b --pretty false",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "preview": "vite preview",
        "db:link": "supabase link --project-ref ijcelrdcygzyzhcijkhe",
        "db:push": "supabase db push",
        "db:status": "supabase migration list --linked",
        "db:new": "supabase migration new",
        "db:start": "supabase start",
        "db:stop": "supabase stop",
        "db:reset": "supabase db reset",
        "db:local-status": "supabase status",
        "db:advisors": "supabase db advisors --local --type security",
        "db:advisors:remote": "supabase db advisors --linked --type security",
        "db:types": "supabase gen types typescript --local > src/shared/api/database.types.ts",
        "shadcn:add": "node scripts/shadcn-add.mjs",
        "shadcn:exports": "node scripts/generate-shadcn-index.mjs",
        "prepare": "husky",
        "secrets:scan": "gitleaks git --staged --redact --verbose",
        "secrets:scan:history": "gitleaks git --redact --verbose",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "playwright test",
        "test:e2e:dev": "E2E_USE_DEV=true playwright test",
        "test:e2e:install": "playwright install --with-deps chromium firefox webkit",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:report": "playwright show-report"
    },
    "dependencies": {
        "@base-ui/react": "^1.6.0",
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@fontsource/ibm-plex-sans": "^5.2.8",
        "@fontsource/jetbrains-mono": "^5.2.8",
        "@fontsource/space-grotesk": "^5.2.10",
        "@git-diff-view/core": "^0.1.7",
        "@git-diff-view/react": "^0.1.7",
        "@marsidev/react-turnstile": "^1.6.1",
        "@supabase/supabase-js": "^2.110.2",
        "@tailwindcss/vite": "^4.3.2",
        "@tanstack/react-query": "^5.101.2",
        "@tanstack/react-router": "^1.170.17",
        "@tanstack/react-router-devtools": "^1.167.0",
        "@tanstack/react-table": "^8.21.3",
        "@tiptap/extension-character-count": "^3.28.0",
        "@tiptap/extension-code-block-lowlight": "^3.28.0",
        "@tiptap/extension-file-handler": "^3.28.0",
        "@tiptap/extension-highlight": "^3.28.0",
        "@tiptap/extension-image": "^3.28.0",
        "@tiptap/extension-link": "^3.28.0",
        "@tiptap/extension-mention": "^3.28.0",
        "@tiptap/extension-placeholder": "^3.28.0",
        "@tiptap/extension-table": "^3.28.0",
        "@tiptap/extension-task-item": "^3.28.0",
        "@tiptap/extension-task-list": "^3.28.0",
        "@tiptap/extension-text-align": "^3.28.0",
        "@tiptap/extension-underline": "^3.28.0",
        "@tiptap/react": "^3.28.0",
        "@tiptap/starter-kit": "^3.28.0",
        "@tiptap/suggestion": "^3.28.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "date-fns": "^4.4.0",
        "fflate": "^0.8.3",
        "i18next": "^26.3.6",
        "i18next-browser-languagedetector": "^8.2.1",
        "lowlight": "^3.3.0",
        "lucide-react": "^1.23.0",
        "motion": "^12.42.2",
        "next-themes": "^0.4.6",
        "react": "^19.2.7",
        "react-day-picker": "^10.0.1",
        "react-dom": "^19.2.7",
        "react-i18next": "^17.0.9",
        "react-loading-skeleton": "^3.5.0",
        "react-markdown": "^10.1.0",
        "remark-gfm": "^4.0.1",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.6.0",
        "tailwindcss": "^4.3.2",
        "tw-animate-css": "^1.4.0",
        "zod": "^4.4.3",
        "zustand": "^5.0.14"
    },
    "devDependencies": {
        "@b12k/gitleaks": "^8.30.1-v.28",
        "@eslint/js": "^9.39.2",
        "@playwright/test": "^1.62.1",
        "@tanstack/router-plugin": "^1.168.19",
        "@types/node": "^24.13.2",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.3",
        "eslint": "^9.39.2",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import-x": "^4.16.1",
        "eslint-plugin-perfectionist": "^5.6.0",
        "eslint-plugin-unicorn": "^62.0.0",
        "globals": "^16.5.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.1.0",
        "playwright": "^1.62.1",
        "prettier": "^3.9.6",
        "shadcn": "^4.14.1",
        "supabase": "^2.109.1",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.50.0",
        "vite": "^8.1.1",
        "vitest": "^3.2.7"
    },
    "overrides": {
        "@hono/node-server": "^2.0.5",
        "fast-uri": "^3.1.4"
    }
}
